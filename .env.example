# ──────────────────────────────────────────────────────────────
# Dire Dawa Cleaning — Docker Compose Configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Database password (PostgreSQL)
DB_PASSWORD=          # REQUIRED — set a strong random password

# Backend session secret (min 32 characters)
SESSION_SECRET=       # REQUIRED — set a strong random string

# Session duration in hours (default: 8)
SESSION_EXPIRY_HOURS=8

# Payment webhook secret (HMAC key, must differ from SESSION_SECRET)
PAYMENT_WEBHOOK_SECRET=

# Max photo upload size in MB (default: 5)
MAX_FILE_SIZE_MB=5

# Host port the frontend is published on (default: 80)
FRONTEND_PORT=80

# CORS origins (comma-separated, leave empty for same-origin in production)
CORS_ORIGINS=
