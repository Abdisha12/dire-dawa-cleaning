# ──────────────────────────────────────────────────────────────
# Dire Dawa Cleaning Backend — Environment Configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Database connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ddcms
DB_PASSWORD=          # REQUIRED — application database password
DB_NAME=dire_dawa_cleaning

# Server
PORT=5000
NODE_ENV=development

# Authentication
SESSION_SECRET=       # REQUIRED — random string, min 32 characters (used for session signing)
SESSION_EXPIRY_HOURS=8

# Login security — brute-force protection
LOGIN_MAX_FAILED=5        # Failed attempts before temporary lockout (default: 5)
LOGIN_LOCKOUT_MINUTES=15  # Lockout duration in minutes (default: 15)

# Payment webhook verification
PAYMENT_WEBHOOK_SECRET=  # REQUIRED for production — HMAC key for webhook signature verification
                         # Must be DIFFERENT from SESSION_SECRET
                         # Falls back to SESSION_SECRET in sandbox mode if not set

# CORS — comma-separated list of allowed frontend origins
# In production (behind nginx), leave empty — frontend and backend share same origin.
# For local development, set to your frontend URL:
#   CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

# Uploads
MAX_FILE_SIZE_MB=5
