# ──────────────────────────────────────────────────────────────
# Dire Dawa Cleaning Backend — Environment Configuration
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=          # REQUIRED — your MySQL/MariaDB password
DB_NAME=dire_dawa_cleaning

# Server
PORT=5000
NODE_ENV=development

# Authentication
SESSION_SECRET=       # REQUIRED — random string, min 32 characters
SESSION_EXPIRY_HOURS=8

# CORS — comma-separated list of allowed frontend origins
# In production (behind nginx), leave empty — frontend and backend share same origin.
# For local development, set to your frontend URL:
#   CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

# Uploads
MAX_FILE_SIZE_MB=5
