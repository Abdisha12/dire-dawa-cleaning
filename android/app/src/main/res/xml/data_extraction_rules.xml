<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules: exclude everything (no cloud backup / no transfer).
     Session tokens are stored encrypted; we still never want them backed up (§31). -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>